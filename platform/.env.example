# Copy to .env for local dev. On Railway, set these in the service Variables tab.

# Provided automatically by the Railway Postgres plugin — reference it there.
DATABASE_URL="postgresql://user:pass@localhost:5432/villasiesta?schema=public"

# Public URL (used in email links). Railway sets PORT automatically.
APP_URL="https://villasiestasarasota.com"

# Auth.js (owner portal) — generate: openssl rand -base64 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="https://villasiestasarasota.com"

# Owner portal login (set before seeding; the seed hashes these into the User table).
OWNER_PASSWORD="change-me"
# Optional read-only viewer (dad):
DAD_EMAIL=""
DAD_PASSWORD=""

# Booking alerts
OWNER_EMAIL="jacob@nicecityhomes.com"
NOTIFY_EMAILS="jacob@nicecityhomes.com, DAD_EMAIL"

# Email (Resend). Leave RESEND_API_KEY blank to log emails to the console instead.
RESEND_API_KEY=""
EMAIL_FROM="Villa Siesta <bookings@villasiestasarasota.com>"

# CSG Forte (payments) — added in the Payments phase (Phase 4)
FORTE_API_ACCESS_ID=""
FORTE_API_SECURE_KEY=""
FORTE_ORGANIZATION_ID=""
FORTE_LOCATION_ID=""
FORTE_ENV="sandbox"                 # sandbox | live
NEXT_PUBLIC_FORTE_API_LOGIN_ID=""   # Forte.js client-side tokenization

# Airbnb calendar export (.ics)
AIRBNB_ICAL_URL=""
